# Copia este archivo a ".env" y completa con tus datos reales.
# NUNCA subas el archivo ".env" (con tus claves reales) a GitHub.

# String de conexión que te entrega Neon (Dashboard > Connection string)
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firmar los tokens de sesión (invéntala, ej: una frase larga random)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto donde correrá el backend
PORT=3001
